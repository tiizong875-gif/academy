APP_NAME="ក្តឹបកូដ Academy"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/academy

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=katteb_academy
DB_USER=root
DB_PASS=

# Upload & File Limits (Bytes)
UPLOAD_MAX_SIZE=20971520

# Session Configuration
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=false

# Hybrid Payment Gateway Configuration
# Mode: 'manual' (default) or 'automated' (requires official merchant credentials)
PAYMENT_MODE=manual

# Bakong / KHQR Open API Credentials (when officially registered)
BAKONG_API_ENABLED=false
BAKONG_API_ENDPOINT=https://api-bakong.nbc.gov.kh/v1
BAKONG_MERCHANT_ID=
BAKONG_ACCOUNT_ID=
BAKONG_API_KEY=
BAKONG_WEBHOOK_SECRET=

# ABA PayWay / KHQR API Credentials (when officially registered)
PAYWAY_API_ENABLED=false
PAYWAY_API_ENDPOINT=https://checkout.payway.com.kh/api/payment-gateway/v1
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_PUBLIC_KEY=
